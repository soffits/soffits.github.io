---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROJECTS } from "@/config/site";
---

<BaseLayout title="Projects" description="Small public projects maintained by Sakina.">
  <section class="page-intro narrow">
    <p class="eyebrow">Projects</p>
    <h1>Small public work, kept inspectable.</h1>
    <p>Current projects are intentionally limited so maintenance can stay careful.</p>
  </section>

  <section class="project-list" aria-label="Project list">
    {
      PROJECTS.map((project) => (
        <article class="panel project-card">
          <h2><a href={project.href}>{project.name}</a></h2>
          <p>{project.description}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
