---
// Sakina: projects page (not part of upstream AstroPaper). The list comes from
// GitHub at build time; the deploy workflow also rebuilds daily.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { GITHUB_PROFILE } from "@/site";
import { getRepos } from "@/lib/repos";

const projects = await getRepos();
import config from "@/config";
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Open-source CLI tools and projects by Sakina."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Projects"
    pageDesc="My public repositories on GitHub, most recently updated first."
  >
    <ul class="project-list">
      {
        projects.map(project => (
          <li class="project-card">
            <h2>
              <a href={project.href}>
                {project.name}
                <IconArrowRight
                  aria-hidden="true"
                  class="project-card-arrow inline-block size-5 rtl:-rotate-180"
                />
              </a>
            </h2>
            <p>{project.description}</p>
            {project.language && <p class="project-meta">{project.language}</p>}
          </li>
        ))
      }
    </ul>
    <p class="project-more">
      <a href={GITHUB_PROFILE}>All repositories on GitHub</a>
    </p>
  </Main>

  <Footer />
</Layout>
