---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROJECTS } from "@/config/site";
---

<BaseLayout title="Projects" description="Open-source CLI tools and projects by Sakina.">
  <section class="page-intro narrow">
    <p class="eyebrow">Projects</p>
    <h1>Open-source tools I build and maintain.</h1>
    <p>Command-line utilities, libraries, and game mods on <a href="https://github.com/soffits">GitHub</a>.</p>
  </section>

  <section class="project-list" aria-label="Project list">
    {
      PROJECTS.map((project) => (
        <article class="panel project-card">
          <h2><a href={project.href}>{project.name}</a></h2>
          <p>{project.description}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
