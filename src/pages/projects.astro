---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROJECTS } from "@/config/site";
---

<BaseLayout title="Projects" description="Developer tools and experiments by Sakina.">
  <section class="page-intro narrow">
    <p class="eyebrow">Projects</p>
    <h1>Projects that earned a repository instead of another private script.</h1>
    <p>Utilities I needed enough to document, test, and keep maintaining after the first useful run.</p>
  </section>

  <section class="project-list" aria-label="Project list">
    {
      PROJECTS.map((project) => (
        <article class="panel project-card">
          <h2><a href={project.href}>{project.name}</a></h2>
          <p>{project.description}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
