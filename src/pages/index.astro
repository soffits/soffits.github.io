---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("posts"))
  .sort((left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf())
  .slice(0, 3);

const getPostSlug = (id: string) => id.replace(/\.(md|mdx)$/, "");
---

<BaseLayout>
  <section class="hero-grid">
    <div class="page-intro">
      <p class="eyebrow">Sakina</p>
      <h1>I build command-line tools, browser extensions, and game mods.</h1>
      <p>
        This is where I keep my open-source projects and write down interesting bugs—like IKEA's Saudi login page redirecting to Australia with HTTP 200, or an OpenWrt router where Tailscale could ping peers while Linux had no routes.
      </p>
      <div class="action-row">
        <a class="button" href="/blog/">Read the blog</a>
        <a class="button subtle" href="/projects/">See projects</a>
      </div>
    </div>
    <aside class="side-card" aria-label="Current work">
      <p class="eyebrow">Recently shipped</p>
      <p>
        51-country support in <a href="https://github.com/soffits/ikea-cli">ikea-cli</a>, streaming download caps in <a href="https://github.com/soffits/seafile-vault-cli">seafile-vault-cli</a>, and AI NPC experiments in <a href="https://github.com/soffits/OpenPlayer">OpenPlayer</a>.
      </p>
    </aside>
  </section>

  <section aria-labelledby="recent-posts-heading">
    <p class="eyebrow">Recently</p>
    <h2 id="recent-posts-heading">Latest posts</h2>
    <div class="panel-grid">
      {
        posts.map((post) => (
          <article class="panel post-card">
            <p class="post-date">
              <time datetime={post.data.pubDate.toISOString()}>
                {new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" }).format(post.data.pubDate)}
              </time>
            </p>
            <h3><a href={`/blog/${getPostSlug(post.id)}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
