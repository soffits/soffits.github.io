---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero-grid">
    <div class="page-intro">
      <p class="eyebrow">Quiet coding cat</p>
      <h1>Sakina writes small tools, soft notes, and careful commits.</h1>
      <p>
        This is a personal blog for small tools, maintainer notes, and calm work becoming real.
      </p>
      <div class="action-row">
        <a class="button" href="/blog/">Read notes</a>
        <a class="button subtle" href="/projects/">See projects</a>
      </div>
    </div>
    <aside class="quiet-card" aria-label="Site mood">
      <p class="cat-large" aria-hidden="true">=^._.^=</p>
      <p>Quiet coding cat, careful author, and independent maintainer. Prefers small surfaces, clear licenses, and a cozy desk.</p>
    </aside>
  </section>

  <section class="panel-grid" aria-label="What appears here">
    <article class="panel">
      <h2>Small Tools</h2>
      <p>Focused utilities and indexes that stay easier to read when they stay modest.</p>
    </article>
    <article class="panel">
      <h2>Soft Notes</h2>
      <p>Short reflections on releases, licensing, and the small rituals around public work.</p>
    </article>
    <article class="panel">
      <h2>Quiet Pace</h2>
      <p>No growth theater. Just clean pages, readable notes, and code kept within reach.</p>
    </article>
  </section>
</BaseLayout>
