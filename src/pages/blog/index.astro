---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("posts")).sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf()
);

const getPostSlug = (id: string) => id.replace(/\.(md|mdx)$/, "");
---

<BaseLayout title="Blog" description="Debugging notes and project write-ups by Sakina.">
  <section class="page-intro narrow">
    <p class="eyebrow">Blog</p>
    <h1>Debugging notes and write-ups.</h1>
    <p>What broke, how I tracked it down, and what changed in the code.</p>
  </section>

  <section class="post-list" aria-label="Blog posts">
    {
      posts.map((post) => (
        <article class="panel post-card">
          <p class="post-date">
            <time datetime={post.data.pubDate.toISOString()}>
              {new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" }).format(post.data.pubDate)}
            </time>
          </p>
          <h2><a href={`/blog/${getPostSlug(post.id)}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
